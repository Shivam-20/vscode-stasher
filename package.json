        },
        {
          "command": "stasher.setStashLabel",
          "when": "view == stasher.stashList && viewItem == stashEntryPinned",
          "group": "6_pin@4"
        },
        {
          "command": "stasher.toggleGroupByDir",
          "when": "view == stasher.stashList && viewItem == stashFile",
          "group": "2_copy@2"
        }
      ]
    },
    "configuration": {
      "title": "Stasher",
      "properties": {
        "stasher.groupByBranch": {
          "type": "boolean",
          "default": false,
          "order": 10,
          "markdownDescription": "**Display:** Group stashes in the tree by the branch they were created on."
        },
        "stasher.groupFilesByDirectory": {
          "type": "boolean",
          "default": false,
          "order": 20,
          "markdownDescription": "**Display:** Group files inside a stash by their parent directory."
        },
        "stasher.groupWorkingByDirectory": {
          "type": "boolean",
          "default": false,
          "order": 30,
          "markdownDescription": "**Display:** Group files in Working Changes by their parent directory."
        },
        "stasher.showFileCountsInTree": {
          "type": "boolean",
          "default": true,
          "order": 50,
          "markdownDescription": "**Display:** Show file counts on collapsed stash rows."
        },
        "stasher.showNotesInTree": {
          "type": "boolean",
          "default": true,
          "order": 60,
          "markdownDescription": "**Display:** Show a short note snippet on stash rows when a note exists."
        },
        "stasher.staleThresholdDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "order": 40,
          "markdownDescription": "**Behavior:** Stashes older than this many days are marked stale and appear in Review Stale Stashes."
        }
      }
    }
