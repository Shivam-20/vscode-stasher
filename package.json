        },
        {
          "command": "stasher.moveFileToStash",
          "when": "view == stasher.stashList && viewItem == stashFile",
          "group": "inline"
        },
        {
          "command": "stasher.deleteFileFromStash",
          "when": "view == stasher.stashList && viewItem == stashFile",
          "group": "inline"
        },
        {
          "command": "stasher.applyHunks",
          "when": "view == stasher.stashList && viewItem == stashFile",
          "group": "1_actions@1"
        },
        {
          "command": "stasher.copyFilePath",
          "when": "view == stasher.stashList && viewItem == stashFile",
